SELECT ?id ?name ?coords
WHERE
{
  ?id wdt:P31 wd:Q928830. # instance of = metro station
  ?id wdt:P16 wd:Q50716. # transport network = Paris Métro
  ?id wdt:P5817 wd:Q55654238. # state of use = in use

  ?id wdt:P625 ?coords.

  # TODO: add interchange station (P833)?

  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "fr".
  
    ?id rdfs:label ?name.
  }
}
