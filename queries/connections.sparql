SELECT DISTINCT ?stationId ?adjacentStationId ?lineId
WHERE
{
  BIND(wd:{subway} as ?transportNetwork)

  ?stationId wdt:P31/wdt:P279* wd:Q928830. # subclass* instance of = metro station
  ?stationId wdt:P16 ?transportNetwork. # transport network
  ?adjacentStationId wdt:P16 ?transportNetwork.

  ?stationId wdt:P5817 wd:Q55654238. # state of use = in use
  ?adjacentStationId wdt:P5817 wd:Q55654238. # state of use = in use
  ?lineId wdt:P5817 wd:Q55654238. # state of use = in use

  # Ensure adjacent station is on the same line
  ?stationId p:P197 ?adjacentStation.
  ?adjacentStation
    ps:P197 ?adjacentStationId;
    pq:P81 ?lineId;
    pq:P5051 ?lineDirection.
}
