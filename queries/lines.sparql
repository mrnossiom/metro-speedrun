SELECT DISTINCT ?qid ?name ?color
WHERE {
  BIND(wd:{subway} as ?transportNetwork)

  ?qid wdt:P31/wdt:P279*/wdt:P361* wd:Q5503. # subclass* part of* instance of = rapid transit
  ?qid wdt:P16 ?transportNetwork. # transport network
  ?qid wdt:P5817 wd:Q55654238. # state of use = in use

  ?qid wdt:P465 ?color.

  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "mul,en,fr".
  
    ?qid rdfs:label ?name
  }
}
