SELECT DISTINCT ?qid ?name ?color
WHERE {
  BIND(wd:{subway} as ?transportNetwork)

  ?qid
    wdt:P31/wdt:P279*/wdt:P361* wd:Q5503; # subclass* part of* instance of = rapid transit
    wdt:P16 ?transportNetwork;            # transport network
    wdt:P5817 wd:Q55654238;               # state of use = in use
    wdt:P465 ?color.

  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "fr,en".

    ?qid rdfs:label ?name
  }
}
